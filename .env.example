# Oracle Database Connection (LCUAT)
# Use ORACLE_USER or ORACLE_USERNAME (both work)
ORACLE_USER=dbo
ORACLE_PASSWORD=dbo
# Easy-connect DSN (host:port/service_name)
ORACLE_DSN=awslcoradb01u.sbl.com:1721/LCUAT
# Thick mode (required if you get "password verifier" error): path to Oracle Instant Client folder, e.g. C:\oracle\instantclient_21_9
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_21_9

# Flask
SECRET_KEY=change-this-to-a-random-string

# Policy table holding the bin number column (T_LIPO_POLICY)
POLICY_TABLE=T_LIPO_POLICY
POLICY_POL_COLUMN=PO_POL_NUM
POLICY_CONT_COLUMN=PO_CONT

# Bin number column to update (defaults to same table as POLICY_TABLE)
BIN_TABLE=T_LIPO_POLICY
BIN_COLUMN=PO_BRK_ACC_NUM

# Audit log table (run create_audit_table.sql once to create it)
# AUDIT_TABLE=T_AUDIT_BIN_LOG
